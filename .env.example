# Optional GitHub Personal Access Token (raises API limit from 60 to 5,000 req/h)
GITHUB_TOKEN=

# Optional free VirusTotal API key (checks SHA-256 hash without uploading files)
VIRUSTOTAL_API_KEY=

# Optional Discord webhook URL for major milestone alerts
DISCORD_WEBHOOK_URL=

# Optional Nexus Mods API key (enables Nexus Mods Workshop adapter when mod_hubs.nexus_game_domain is set)
NEXUS_API_KEY=

# Optional SteamGridDB API key (fetches grid/hero artwork when exporting a Steam shortcut)
STEAMGRIDDB_API_KEY=

# Optional custom User-Agent for Reddit feeds
REDDIT_USER_AGENT=python:sixdeck-launcher:v1.0.0 (community runtime watcher)
